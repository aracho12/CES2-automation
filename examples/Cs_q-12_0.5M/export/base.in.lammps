pair_coeff   10  10  lj/cut/tip4p/long/opt  0.0000000  1.0000   # O_bulk-O_bulk  [QM: zero LJ]
pair_coeff   10  11  lj/cut/tip4p/long/opt  0.0000000  1.0000   # O_bulk-O_surf  [QM: zero LJ]
pair_coeff   11  11  lj/cut/tip4p/long/opt  0.0000000  1.0000   # O_surf-O_surf  [QM: zero LJ]

# ============================================================
# 5. bjdisp pair coefficients  (QM-MM dispersion)
# ============================================================

# QM-MM dispersion (bjdisp): alpha_rms [a.u.], s, C6 [kcal/mol*Ang^6]
# Format: pair_coeff <MM_type> <QM_type> bjdisp <alpha_rms> <s> <C6>
pair_coeff    1   6 bjdisp 1.9083089373 0.53 42.7158952  # Hw-H_ads
pair_coeff    1   7 bjdisp 7.1359888009 0.53 424.0472709  # Hw-Ir_bulk
pair_coeff    1   8 bjdisp 7.0391313100 0.53 424.0472709  # Hw-Ir_surf
pair_coeff    1   9 bjdisp 2.8051851989 0.53 78.2393682  # Hw-O_ads
pair_coeff    1  10 bjdisp 2.6190924588 0.53 78.2682975  # Hw-O_bulk
pair_coeff    1  11 bjdisp 2.6661475328 0.53 78.2393682  # Hw-O_surf
pair_coeff    2   6 bjdisp 3.1996381827 1.40 78.2392890  # Ow-H_ads
pair_coeff    2   7 bjdisp 11.9648248734 1.40 776.6934725  # Ow-Ir_bulk
pair_coeff    2   8 bjdisp 11.8024251067 1.40 776.6934725  # Ow-Ir_surf
pair_coeff    2   9 bjdisp 4.7034196071 1.40 143.3047935  # Ow-O_ads
pair_coeff    2  10 bjdisp 4.3914001929 1.40 143.3577810  # Ow-O_bulk
pair_coeff    2  11 bjdisp 4.4702968582 1.40 143.3047935  # Ow-O_surf
pair_coeff    3   6 bjdisp 5.6802288686 1.40 275.5512938  # Cs-H_ads
pair_coeff    3   7 bjdisp 21.2408215472 1.40 2735.4401364  # Cs-Ir_bulk
pair_coeff    3   8 bjdisp 20.9525177485 1.40 2735.4401364  # Cs-Ir_surf
pair_coeff    3   9 bjdisp 8.3498502981 1.40 504.7057787  # Cs-O_ads
pair_coeff    3  10 bjdisp 7.7959308913 1.40 504.8923957  # Cs-O_bulk
pair_coeff    3  11 bjdisp 7.9359939516 1.40 504.7057787  # Cs-O_surf
pair_coeff    4   6 bjdisp 3.7172602814 0.53 42.7158952  # H_oh-H_ads
pair_coeff    4   7 bjdisp 13.9004367797 0.53 424.0472709  # H_oh-Ir_bulk
pair_coeff    4   8 bjdisp 13.7117647588 0.53 424.0472709  # H_oh-Ir_surf
pair_coeff    4   9 bjdisp 5.4643162427 0.53 78.2393682  # H_oh-O_ads
pair_coeff    4  10 bjdisp 5.1018198261 0.53 78.2682975  # H_oh-O_bulk
pair_coeff    4  11 bjdisp 5.1934800150 0.53 78.2393682  # H_oh-O_surf
pair_coeff    5   6 bjdisp 3.4650948039 1.40 86.7986032  # O_oh-H_ads
pair_coeff    5   7 bjdisp 12.9574814811 1.40 861.6631037  # O_oh-Ir_bulk
pair_coeff    5   8 bjdisp 12.7816082869 1.40 861.6631037  # O_oh-Ir_surf
pair_coeff    5   9 bjdisp 5.0936368147 1.40 158.9822208  # O_oh-O_ads
pair_coeff    5  10 bjdisp 4.7557308425 1.40 159.0410051  # O_oh-O_bulk
pair_coeff    5  11 bjdisp 4.8411731361 1.40 158.9822208  # O_oh-O_surf

# QM-QM dispersion: set to 0 (handled inside DFT)
pair_coeff    6   6 bjdisp 0.0 0.0 0.0  # H_ads-H_ads
pair_coeff    6   7 bjdisp 0.0 0.0 0.0  # H_ads-Ir_bulk
pair_coeff    6   8 bjdisp 0.0 0.0 0.0  # H_ads-Ir_surf
pair_coeff    6   9 bjdisp 0.0 0.0 0.0  # H_ads-O_ads
pair_coeff    6  10 bjdisp 0.0 0.0 0.0  # H_ads-O_bulk
pair_coeff    6  11 bjdisp 0.0 0.0 0.0  # H_ads-O_surf
pair_coeff    7   7 bjdisp 0.0 0.0 0.0  # Ir_bulk-Ir_bulk
pair_coeff    7   8 bjdisp 0.0 0.0 0.0  # Ir_bulk-Ir_surf
pair_coeff    7   9 bjdisp 0.0 0.0 0.0  # Ir_bulk-O_ads
pair_coeff    7  10 bjdisp 0.0 0.0 0.0  # Ir_bulk-O_bulk
pair_coeff    7  11 bjdisp 0.0 0.0 0.0  # Ir_bulk-O_surf
pair_coeff    8   8 bjdisp 0.0 0.0 0.0  # Ir_surf-Ir_surf
pair_coeff    8   9 bjdisp 0.0 0.0 0.0  # Ir_surf-O_ads
pair_coeff    8  10 bjdisp 0.0 0.0 0.0  # Ir_surf-O_bulk
pair_coeff    8  11 bjdisp 0.0 0.0 0.0  # Ir_surf-O_surf
pair_coeff    9   9 bjdisp 0.0 0.0 0.0  # O_ads-O_ads
pair_coeff    9  10 bjdisp 0.0 0.0 0.0  # O_ads-O_bulk
pair_coeff    9  11 bjdisp 0.0 0.0 0.0  # O_ads-O_surf
pair_coeff   10  10 bjdisp 0.0 0.0 0.0  # O_bulk-O_bulk
pair_coeff   10  11 bjdisp 0.0 0.0 0.0  # O_bulk-O_surf
pair_coeff   11  11 bjdisp 0.0 0.0 0.0  # O_surf-O_surf

# ============================================================
# 6. Bond / angle coefficients  (needed for TIP4P M-site)
# ============================================================

# These mirror what is in data.file. Required here for TIP4P M-site computation.
bond_coeff      1  450.0  0.9572
bond_coeff      2  450.0  0.9700
angle_coeff     1  55.0  104.52

# ============================================================
# 7. CES2 gridforce/net fixes
# ============================================================

# Format: fix NAME GROUP gridforce/net WEIGHT SC_FACTOR CUBE_IDX ELEMENT
#         [TIP4P O_type H_type bond_len angle M_dist O_cube_idx]
# Supercell factor = 3×6×1 = 18

fix hGrid PROTON gridforce/net  -1  18  0  H  TIP4P 2 1 0.9572 104.52 0.125 1
fix oGrid OXYGEN gridforce/net  -1  18  1  O  TIP4P 2 1 0.9572 104.52 0.125 1
fix_modify hGrid energy yes
fix_modify oGrid energy yes

variable Egrid_H    equal f_hGrid[1]
variable EgridInd_H equal f_hGrid[2]
variable EgridRep_H equal f_hGrid[3]
variable Egrid_O    equal f_oGrid[1]
variable EgridInd_O equal f_oGrid[2]
variable EgridRep_O equal f_oGrid[3]

# Non-water species gridforce/net fixes (one per type_label)
fix CsGrid CS gridforce/net  -1  18  2  Cs
fix_modify CsGrid energy yes
variable Egrid_Cs                 equal f_CsGrid[1]
variable EgridInd_Cs              equal f_CsGrid[2]
variable EgridRep_Cs              equal f_CsGrid[3]
fix HohGrid H_OH gridforce/net  -1  18  3  H
fix_modify HohGrid energy yes
variable Egrid_H_oh               equal f_HohGrid[1]
variable EgridInd_H_oh            equal f_HohGrid[2]
variable EgridRep_H_oh            equal f_HohGrid[3]
fix OohGrid O_OH gridforce/net  -1  18  4  O
fix_modify OohGrid energy yes
variable Egrid_O_oh               equal f_OohGrid[1]
variable EgridInd_O_oh            equal f_OohGrid[2]
variable EgridRep_O_oh            equal f_OohGrid[3]

# ------------------------------------------------------------------
# The qmmm wrapper replaces the marker below with grid command.
# Do NOT remove or rename this marker!
# ------------------------------------------------------------------

#CUBEPOSITION

# ============================================================
# 8. MD settings
# ============================================================

timestep        1.0

neighbor        2.0 multi
neigh_modify    every 2 delay 4 check yes
neigh_modify    exclude group SOLUTE SOLUTE
neigh_modify    one 4000

# Dispersion force tracking (QM←→MM via bjdisp)
compute fdisp SOLUTE force/tally SOLVENT
fix     showf all ave/atom 1 200 200 c_fdisp[*]
dump    dispTraj SOLUTE custom 100 dispf.ave id type xu yu zu f_showf[*]
dump_modify dispTraj sort id

# bjdisp energy (for thermo)
compute edisp all pair bjdisp

thermo_style    custom step temp etotal ke pe evdwl ecoul elong press &
                v_Egrid_H v_EgridRep_H v_Egrid_O v_EgridRep_O &
                v_EgridInd_H v_EgridInd_O v_Egrid_Cs v_EgridRep_Cs &
                v_EgridInd_Cs v_Egrid_H_oh v_EgridRep_H_oh v_EgridInd_H_oh &
                v_Egrid_O_oh v_EgridRep_O_oh v_EgridInd_O_oh &
                c_edisp
thermo_modify   line multi format float %10.5f
thermo          100

# Keep solvent from escaping through fixed-z boundaries
fix             wallhi SOLVENT wall/harmonic zhi 70.17 1.0 1.0 5.0

# Remove spurious COM momentum drift
fix   momentum SOLVENT momentum 1 linear 1 1 0 angular

# SHAKE: rigid X-H bonds and H-O-H angles (water + solute, e.g. OH-)
fix   shakeH SOLVENT shake 0.0001 20 500 a 1 b 1 2

fix   nvt SOLVENT nvt temp 300.0 300.0 100.0

dump    traj all custom 1000 ces2.emd.lammpstrj id type xu yu zu fx fy fz
dump_modify traj sort id

restart         500000  ces2.*.restart

run             0

