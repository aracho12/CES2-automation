pair_coeff    6   9  lj/cut/tip4p/long/opt  0.0000000  1.0000   # H_ads-O_ads  [QM: zero LJ]
pair_coeff    6  10  lj/cut/tip4p/long/opt  0.0000000  1.0000   # H_ads-O_bulk  [QM: zero LJ]
