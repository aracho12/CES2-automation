# base.in.lammps — DFT-CES2 QM/MM LAMMPS input
# Auto-generated by cesbuild  (lammps_input_writer.py)
#
# Water model : TIP4P
# Supercell   : 3x6x1 → gridforce factor = 18
#
# Runtime markers (replaced by qmmm_dftces2_charging_pts.sh):
#   ###qmxyz      → QM atom XYZ coordinates (in base.pw.in)
#   ###dispf      → dispersion forces       (in base.pw.in)
#   CUBEPOSITION  → replaced with  grid <cubes> ...  command

# ============================================================
# 1. Initialization
# ============================================================

units           real
atom_style      full
boundary        p p f

dielectric      1
special_bonds   lj/coul 0.0 0.0 1.0   # 1-2 excluded, 1-3 excluded, 1-4 full

bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none

# TIP4P-EW: O_type=2 H_type=1 bond_type=1 angle_type=1 M_dist=0.125 cutoff=15.0
pair_style      hybrid/overlay lj/cut/tip4p/long/opt 2 1 1 1 0.125 15.0 bjdisp 15
kspace_style    pppm/tip4p 1.0e-04
kspace_modify   slab 3.0   # 2D periodic slab correction

processors      * * 1   # no domain decomposition in z

# ============================================================
# 2. Read data
# ============================================================

read_data       data.file
reset_timestep  0


# ============================================================
# 3. Group definitions
# ============================================================

# QM (slab) atoms = SOLUTE
group    SOLUTE   type 6 7 8 9 10 11   # QM slab: H_ads Ir_bulk Ir_surf O_ads O_bulk O_surf

# Water sub-groups
group    OXYGEN   type 2   # Ow (water O)
group    PROTON   type 1   # Hw (water H)
group    WATER    union OXYGEN PROTON

# Non-water species: one group per type_label (used by gridforce/net fixes)
# Polyatomic species (e.g. OH-) also get a species-level union group.
group    CS           type 3   # Cs (Cs)
group    H_OH         type 4   # H_oh (H)
group    O_OH         type 5   # O_oh (O)
group    OH_MINUS     union H_OH O_OH   # all OH_minus

group    SOLVENT  subtract all SOLUTE   # all MM atoms

# TIP4P-Ew water charges (overwrite data.file values)
set group PROTON charge 0.5242
set group OXYGEN charge -1.0484

# Charged surface layer regions
region   toplayer    block 0 38.2188 0 38.3964 10.7212 10.9579 units box
group    top         region toplayer
region   centerlayer block 0 38.2188 0 38.3964 0.00 10.17 units box
group    center      region centerlayer

# Charged system: distribute q_electrode=-12.000000 across 288 top-layer atoms
set group top charge -0.041666666666666664

# ============================================================
# 4. LJ pair coefficients
# ============================================================

# Lorentz-Berthelot mixing; QM-involved pairs: epsilon=0

pair_coeff    1   1  lj/cut/tip4p/long/opt  0.0000000  1.00000   # Hw-Hw
pair_coeff    1   2  lj/cut/tip4p/long/opt  0.0000000  2.08218   # Hw-Ow
pair_coeff    1   3  lj/cut/tip4p/long/opt  0.0000000  2.18201   # Hw-Cs
pair_coeff    1   4  lj/cut/tip4p/long/opt  0.0000000  1.00000   # Hw-H_oh
pair_coeff    1   5  lj/cut/tip4p/long/opt  0.0000000  2.40500   # Hw-O_oh
pair_coeff    1   6  lj/cut/tip4p/long/opt  0.0000000  1.0000   # Hw-H_ads  [QM: zero LJ]
pair_coeff    1   7  lj/cut/tip4p/long/opt  0.0000000  1.0000   # Hw-Ir_bulk  [QM: zero LJ]
pair_coeff    1   8  lj/cut/tip4p/long/opt  0.0000000  1.0000   # Hw-Ir_surf  [QM: zero LJ]
pair_coeff    1   9  lj/cut/tip4p/long/opt  0.0000000  1.0000   # Hw-O_ads  [QM: zero LJ]
pair_coeff    1  10  lj/cut/tip4p/long/opt  0.0000000  1.0000   # Hw-O_bulk  [QM: zero LJ]
pair_coeff    1  11  lj/cut/tip4p/long/opt  0.0000000  1.0000   # Hw-O_surf  [QM: zero LJ]
pair_coeff    2   2  lj/cut/tip4p/long/opt  0.1627500  3.16435   # Ow-Ow
pair_coeff    2   3  lj/cut/tip4p/long/opt  0.2533649  3.26419   # Ow-Cs
pair_coeff    2   4  lj/cut/tip4p/long/opt  0.0000000  2.08218   # Ow-H_oh
pair_coeff    2   5  lj/cut/tip4p/long/opt  0.0441006  3.48718   # Ow-O_oh
pair_coeff    2   6  lj/cut/tip4p/long/opt  0.0000000  1.0000   # Ow-H_ads  [QM: zero LJ]
pair_coeff    2   7  lj/cut/tip4p/long/opt  0.0000000  1.0000   # Ow-Ir_bulk  [QM: zero LJ]
pair_coeff    2   8  lj/cut/tip4p/long/opt  0.0000000  1.0000   # Ow-Ir_surf  [QM: zero LJ]
