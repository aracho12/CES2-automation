pair_coeff    2  11  lj/cut/tip4p/long/opt  0.0000000  1.0000   # Ow-O_surf  [QM: zero LJ]
pair_coeff    3   3  lj/cut/tip4p/long/opt  0.3944318  3.36403   # Cs-Cs
pair_coeff    3   4  lj/cut/tip4p/long/opt  0.0000000  2.18201   # Cs-H_oh
pair_coeff    3   5  lj/cut/tip4p/long/opt  0.0686546  3.58702   # Cs-O_oh
