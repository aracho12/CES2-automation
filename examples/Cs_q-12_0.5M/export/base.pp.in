! base.pp.in — DFT-CES2 QM/MM  (Quantum ESPRESSO pp.x)
! Auto-generated by cesbuild  (qe_writer.py)
!
! pp.x converts the SCF output to a cube file of the electrostatic
! potential (plot_num=11 → solute.pot.cube).  The qmmm wrapper script
! also generates solute.rho.cube (plot_num=0) for diagnostics.

&inputpp
  prefix   = 'solute',
  outdir   = './solute',
  filplot  = 'solute.temp',
  plot_num = 11,
/

&plot
  nfile         = 1,
  filepp(1)     = 'solute.temp',
  weight(1)     = 1.0,
  iflag         = 3,
  output_format = 6,
  fileout       = 'solute.pot.cube',
/
